@page "/portfolio"
@layout Components.Layout.PortfolioLayout
@using PortfolioKylian.Resources
@inject LocalizationHelper L
@inject ICultureService CultureService
@implements IDisposable

<link rel="stylesheet" href="css/portfolio-hub.css" />

<PageTitle>@L["Portfolio.Title"] - Kylian Debonne</PageTitle>

<div class="portfolio-hub">
    <header class="hub-header">
        <h1 class="hub-title">@L["Portfolio.Hub.Title"]</h1>
        <p class="hub-subtitle">@L["Portfolio.Hub.Subtitle"]</p>
    </header>

    <div class="hub-cards">
        <a href="/portfolio/my-projects" class="hub-card">
            <div class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                    <path d="M2 17l10 5 10-5"></path>
                    <path d="M2 12l10 5 10-5"></path>
                </svg>
            </div>
            <h3 class="card-title">@L["Portfolio.Hub.PreBachelor.Title"]</h3>
            <p class="card-description">@L["Portfolio.Hub.PreBachelor.Description"]</p>
        </a>

        <a href="/portfolio/but" class="hub-card">
            <div class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                </svg>
            </div>
            <h3 class="card-title">@L["Portfolio.Hub.But.Title"]</h3>
            <p class="card-description">@L["Portfolio.Hub.But.Description"]</p>
        </a>

        <a href="/portfolio/apprenticeship" class="hub-card">
            <div class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                </svg>
            </div>
            <h3 class="card-title">@L["Portfolio.Hub.Apprenticeship.Title"]</h3>
            <p class="card-description">@L["Portfolio.Hub.Apprenticeship.Description"]</p>
        </a>

        <a href="/portfolio/post-but" class="hub-card">
            <div class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
            </div>
            <h3 class="card-title">@L["Portfolio.Hub.PostBachelor.Title"]</h3>
            <p class="card-description">@L["Portfolio.Hub.PostBachelor.Description"]</p>
        </a>

        <a href="/portfolio/game-engines" class="hub-card">
            <div class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="6" y1="12" x2="10" y2="12"></line>
                    <line x1="8" y1="10" x2="8" y2="14"></line>
                    <line x1="15" y1="13" x2="15.01" y2="13"></line>
                    <line x1="18" y1="11" x2="18.01" y2="11"></line>
                    <rect x="2" y="6" width="20" height="12" rx="2" ry="2"></rect>
                </svg>
            </div>
            <h3 class="card-title">@L["Portfolio.Hub.GameEngines.Title"]</h3>
            <p class="card-description">@L["Portfolio.Hub.GameEngines.Description"]</p>
        </a>

        <a href="/portfolio/beyond-academics/general-knowledge" class="hub-card">
            <div class="card-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                </svg>
            </div>
            <h3 class="card-title">@L["Portfolio.Hub.BeyondAcademics.Title"]</h3>
            <p class="card-description">@L["Portfolio.Hub.BeyondAcademics.Description"]</p>
        </a>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        CultureService.OnCultureChanged += OnCultureChanged;
        L.OnLanguageChanged += OnLanguageChanged;
    }

    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= OnCultureChanged;
        L.OnLanguageChanged -= OnLanguageChanged;
    }
}
