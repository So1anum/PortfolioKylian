@page "/apropos"

<PageTitle>À propos - Kylian Debonne</PageTitle>

<div class="apropos-container">
    <h1>👨‍💻 À propos de moi</h1>

    <div class="intro">
        <p>
            Bonjour ! Je suis <strong>Kylian Debonne</strong>,
            développeur d'applications passionné par le C# et .NET.
        </p>
        <p>
            Actuellement en recherche d'opportunités professionnelles
            pour mettre mes compétences au service de projets innovants.
        </p>
    </div>

    <div class="parcours">
        <h2>📚 Mon parcours</h2>
        <ul>
            <li>🎓 Formation en développement d'applications</li>
            <li>💻 Spécialisation C# / .NET</li>
            <li>☁️ Expérience avec Azure et le cloud</li>
            <li>🔄 Pratique du CI/CD avec GitHub Actions</li>
        </ul>
    </div>

    <div class="technologies">
        <h2>🛠️ Technologies que j'utilise</h2>
        <div class="tech-grid">
            <span class="tech-badge">C#</span>
            <span class="tech-badge">.NET Core</span>
            <span class="tech-badge">Blazor</span>
            <span class="tech-badge">ASP.NET</span>
            <span class="tech-badge">Azure</span>
            <span class="tech-badge">Git</span>
            <span class="tech-badge">SQL Server</span>
            <span class="tech-badge">Visual Studio</span>
        </div>
    </div>

    <div class="contact-cta">
        <h2>📬 Intéressé par mon profil ?</h2>
        <p>N'hésitez pas à me contacter !</p>
        <a href="/contact" class="btn btn-primary">Me contacter</a>
    </div>
</div>

<style>
    .apropos-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
    }

    .intro {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2rem;
        border-radius: 15px;
        margin: 2rem 0;
    }

    .parcours, .technologies {
        margin: 3rem 0;
    }

        .parcours ul {
            list-style: none;
            padding: 0;
        }

        .parcours li {
            padding: 0.75rem;
            margin: 0.5rem 0;
            background: #f5f5f5;
            border-radius: 8px;
            border-left: 4px solid #667eea;
        }

    .tech-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        margin-top: 1rem;
    }

    .tech-badge {
        background: #667eea;
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .contact-cta {
        text-align: center;
        padding: 3rem 2rem;
        background: #f9f9f9;
        border-radius: 15px;
        margin-top: 3rem;
    }

    .btn {
        display: inline-block;
        padding: 12px 30px;
        background: #667eea;
        color: white;
        text-decoration: none;
        border-radius: 25px;
        font-weight: 600;
        transition: transform 0.2s;
    }

        .btn:hover {
            transform: translateY(-2px);
            background: #764ba2;
        }
</style>