@code {
    [Inject] private IContactService ContactService { get; set; } = default!;
    [Inject] private ICustomToastService ToastService { get; set; } = default!;

    private ContactFormModel contactForm = new();
    private bool isSubmitting = false;

    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        try
        {
            isSubmitting = true;

            // Envoi via Formspree
            var success = await ContactService.SendContactMessageAsync(
                contactForm.Name, 
                contactForm.Email, 
                contactForm.Subject, 
                contactForm.Message
            );

            if (success)
            {
                ToastService.ShowSuccess(L["Toast.Success"]);
                contactForm = new();
            }
            else
            {
                ToastService.ShowError(L["Toast.Error"]);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(L["Toast.ErrorUnexpected"]);
            Console.WriteLine($"Erreur lors de l'envoi: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    protected override void OnInitialized()
    {
        CultureService.OnCultureChanged += OnCultureChanged;
        L.OnLanguageChanged += OnLanguageChanged;
    }

    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= OnCultureChanged;
        L.OnLanguageChanged -= OnLanguageChanged;
    }

    private class ContactFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Subject { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }
}
