@code {
    [Inject] private IContactService ContactService { get; set; } = default!;
    [Inject] private IToastService ToastService { get; set; } = default!;

    private ContactFormModel contactForm = new();
    private bool isSubmitting = false;

    private async Task HandleSubmit()
    {
        if (isSubmitting) return;

        try
        {
            isSubmitting = true;

            // Envoi via Formspree
            var success = await ContactService.SendContactMessageAsync(
                contactForm.Name, 
                contactForm.Email, 
                contactForm.Subject, 
                contactForm.Message
            );

            if (success)
            {
                ToastService.ShowSuccess("Votre message a été envoyé avec succès ! Je vous répondrai dans les plus brefs délais.");
                contactForm = new();
            }
            else
            {
                ToastService.ShowError("Une erreur s'est produite lors de l'envoi de votre message. Veuillez réessayer ou me contacter directement par email.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Une erreur inattendue s'est produite. Veuillez réessayer plus tard.");
            Console.WriteLine($"Erreur lors de l'envoi: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private class ContactFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Subject { get; set; } = string.Empty;
        public string Message { get; set; } = string.Empty;
    }
}
