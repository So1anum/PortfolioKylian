            <form class="contact-form" @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                <div class="form-group">
                    <label for="name">Nom complet</label>
                    <input type="text" id="name" @bind="contactForm.Name" required />
                </div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="email" id="email" @bind="contactForm.Email" required />
                </div>
                <div class="form-group">
                    <label for="subject">Sujet</label>
                    <input type="text" id="subject" @bind="contactForm.Subject" required />
                </div>
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" rows="5" @bind="contactForm.Message" required></textarea>
                </div>
                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span>Envoi en cours...</span>
                    }
                    else
                    {
                        <span>Envoyer le message</span>
                    }
                </button>
            </form>
