@page "/"
@layout Components.Layout.FullScreenLayout
@using PortfolioKylian.Components.Layout
@using PortfolioKylian.Resources
@inject LocalizationHelper L
@implements IDisposable
@inject ICultureService CultureService

<PageTitle>Kylian Debonne - @L["Hero.Subtitle"]</PageTitle>

<Header @rendermode="InteractiveServer" />

<!-- Section Présentation -->
<section id="presentation" class="hero-section">
    <div class="hero-content">
        <div class="hero-visual">
            <div class="orb-container">
                <div class="orb">
                    <div class="orb-inner">
                        <img src="@($"{Configuration["Media:BaseUrl"]}images/profile-photo.jpg")" alt="Kylian Debonne" class="profile-image" />
                    </div>
                </div>
            </div>
        </div>
        
        <div class="hero-text">
            <p class="hero-subtitle">@L["Hero.Subtitle"]</p>
            <h1 class="hero-title">Kylian Debonne</h1>
            <p class="hero-description">
                @L["Hero.Description"]
            </p>
            <div class="hero-actions">
                <a href="#contact" class="btn btn-primary">@L["Hero.ContactMe"]</a>
            </div>
        </div>
    </div>
    
    <div class="hero-footer">
        <div class="social-links">
            <a href="https://github.com/So1anum" target="_blank" rel="noopener" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
            </a>
            <a href="https://www.linkedin.com/in/kylian-debonne-5b359a3b3/" target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
            </a>
        </div>
    </div>
</section>

<!-- Section À propos -->
<section id="about" class="about-section">
    <div class="section-container">
        <h2 class="section-title">@L["About.Title"]</h2>
        <div class="about-content">
            <div class="about-text">
                <p>@L.Html("About.Paragraph1")</p>
                <p>@L.Html("About.Paragraph2")</p>
                <p>@L.Html("About.Paragraph3")</p>
            </div>
            <div class="about-stats">
                <div class="stat-card">
                    <div class="stat-number">26</div>
                    <div class="stat-label">@L["About.MonthsExperience"]</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">7+</div>
                    <div class="stat-label">@L["About.LanguagesMastered"]</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">Europe</div>
                    <div class="stat-label">@L["About.Relocation"]</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section Langues -->
<section id="languages" class="languages-section">
    <div class="section-container">
        <h2 class="section-title">@L["Languages.Title"]</h2>
        <div class="languages-list">
            <!-- Français -->
            <div class="language-item">
                <div class="language-header">
                    <h3 class="language-name">@L["Languages.French"]</h3>
                    <span class="language-level native">@L["Languages.Native"]</span>
                </div>
                <div class="language-bar">
                    <div class="language-fill native-fill"></div>
                </div>
            </div>

            <!-- Anglais -->
            <div class="language-item">
                <div class="language-header">
                    <h3 class="language-name">@L["Languages.English"]</h3>
                    <span class="language-level professional">@L["Languages.Professional"]</span>
                </div>
                <div class="language-bar">
                    <div class="language-fill professional-fill"></div>
                </div>
                <div class="language-certification">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    <span>TOEIC 2026 : 835/990</span>
                </div>
            </div>

            <!-- Allemand -->
            <div class="language-item">
                <div class="language-header">
                    <h3 class="language-name">@L["Languages.German"]</h3>
                    <span class="language-level basic">@L["Languages.Basic"]</span>
                </div>
                <div class="language-bar">
                    <div class="language-fill basic-fill"></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section Compétences -->
<section id="skills" class="skills-section">
    <div class="section-container">
        <h2 class="section-title">@L["Skills.Title"]</h2>
        <div class="skills-grid">
            <!-- Langages de programmation -->
            <div class="skill-category">
                <h3 class="category-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="16 18 22 12 16 6"></polyline>
                        <polyline points="8 6 2 12 8 18"></polyline>
                    </svg>
                    @L["Skills.ProgrammingLanguages"]
                </h3>
                <div class="skills-badges">
                    <span class="skill-badge">C#</span>
                    <span class="skill-badge">Java</span>
                    <span class="skill-badge">Python</span>
                    <span class="skill-badge">JavaScript</span>
                    <span class="skill-badge">Kotlin</span>
                    <span class="skill-badge">PHP</span>
                    <span class="skill-badge">C/C++</span>
                </div>
            </div>

            <!-- Backend & API -->
            <div class="skill-category">
                <h3 class="category-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M12 1v6m0 6v6m8.66-13.66l-5.2 3m-3.92 3.92l-5.2 3M1 12h6m6 0h6m-8.66 8.66l3-5.2m3.92-3.92l3-5.2"></path>
                    </svg>
                    @L["Skills.BackendAPI"]
                </h3>
                <div class="skills-badges">
                    <span class="skill-badge">.NET</span>
                    <span class="skill-badge">ASP.NET Core</span>
                    <span class="skill-badge">Entity Framework</span>
                    <span class="skill-badge">Symfony</span>
                    <span class="skill-badge">Maven</span>
                    <span class="skill-badge">Gradle</span>
                </div>
            </div>

            <!-- Frontend & Web -->
            <div class="skill-category">
                <h3 class="category-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    </svg>
                    @L["Skills.FrontendWeb"]
                </h3>
                <div class="skills-badges">
                    <span class="skill-badge">Blazor</span>
                    <span class="skill-badge">React</span>
                    <span class="skill-badge">HTML/CSS</span>
                    <span class="skill-badge">Bootstrap</span>
                    <span class="skill-badge">Razor</span>
                </div>
            </div>

            <!-- Bases de données -->
            <div class="skill-category">
                <h3 class="category-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                    </svg>
                    @L["Skills.Databases"]
                </h3>
                <div class="skills-badges">
                    <span class="skill-badge">SQL Server</span>
                    <span class="skill-badge">MySQL</span>
                    <span class="skill-badge">MongoDB</span>
                    <span class="skill-badge">Neo4J</span>
                </div>
            </div>

            <!-- DevOps & Infrastructure -->
            <div class="skill-category">
                <h3 class="category-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                    @L["Skills.DevOps"]
                </h3>
                <div class="skills-badges">
                    <span class="skill-badge">Git</span>
                    <span class="skill-badge">GitHub</span>
                    <span class="skill-badge">GitLab</span>
                    <span class="skill-badge">Docker</span>
                    <span class="skill-badge">Azure</span>
                    <span class="skill-badge">Linux</span>
                    <span class="skill-badge">CI/CD</span>
                </div>
            </div>

            <!-- Méthodologies & Qualité -->
            <div class="skill-category">
                <h3 class="category-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                        <polyline points="22 4 12 14.01 9 11.01"></polyline>
                    </svg>
                    @L["Skills.Methodologies"]
                </h3>
                <div class="skills-badges">
                    <span class="skill-badge">Agile (Scrum)</span>
                    <span class="skill-badge">Kanban</span>
                    <span class="skill-badge">POO</span>
                    <span class="skill-badge">MVC</span>
                    <span class="skill-badge">UML</span>
                    <span class="skill-badge">@L["Skills.UnitTests"]</span>
                    <span class="skill-badge">JUnit</span>
                    <span class="skill-badge">Selenium</span>
                    <span class="skill-badge">Jest</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section Formation -->
<section id="education" class="education-section">
    <div class="section-container">
        <h2 class="section-title">@L["Education.Title"]</h2>
        <div class="timeline">
            <div class="timeline-item">
                <div class="timeline-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                    </svg>
                </div>
                <div class="timeline-content">
                    <span class="timeline-date">2026 (@L["Education.InProgress"])</span>
                    <h3 class="timeline-title">@L["Education.BUT"]</h3>
                    <p class="timeline-location">@L["Education.University"]</p>
                    <p class="timeline-description">@L["Education.BUTDescription"]</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                    </svg>
                </div>
                <div class="timeline-content">
                    <span class="timeline-date">2025</span>
                    <h3 class="timeline-title">@L["Education.DUT"]</h3>
                    <p class="timeline-location">@L["Education.University"]</p>
                    <p class="timeline-description">@L["Education.DUTDescription"]</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                    </svg>
                </div>
                <div class="timeline-content">
                    <span class="timeline-date">2023</span>
                    <h3 class="timeline-title">@L["Education.BAC"]</h3>
                    <p class="timeline-location">@L["Education.HighSchool"]</p>
                    <p class="timeline-description">@L["Education.BACDescription"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Section CV -->
<section id="cv" class="cv-section">
    <div class="section-container">
        <h2 class="section-title">@L["CV.Title"]</h2>
        <div class="cv-intro">
            <p>@L["CV.Intro"]</p>
        </div>
        <div class="cv-grid">
            <!-- CV Général -->
            <div class="cv-card">
                <div class="cv-icon general">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                        <polyline points="14 2 14 8 20 8"></polyline>
                        <line x1="16" y1="13" x2="8" y2="13"></line>
                        <line x1="16" y1="17" x2="8" y2="17"></line>
                        <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                </div>
                <h3 class="cv-card-title">@L["CV.General.Title"]</h3>
                <p class="cv-card-description">
                    @L["CV.General.Description"]
                </p>
                <ul class="cv-highlights">
                    <li>@L["CV.General.Highlight1"]</li>
                    <li>@L["CV.General.Highlight2"]</li>
                    <li>@L["CV.General.Highlight3"]</li>
                </ul>
                <a href="@($"{Configuration["Media:BaseUrl"]}{L["CV.General.DownloadLink"]}")" target="_blank" rel="noopener noreferrer" class="btn-cv-download">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    @L["CV.Download"]
                </a>
            </div>

            <!-- CV .NET -->
            <div class="cv-card">
                <div class="cv-icon dotnet">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M12 1v6m0 6v6m8.66-13.66l-5.2 3m-3.92 3.92l-5.2 3M1 12h6m6 0h6m-8.66 8.66l3-5.2m3.92-3.92l3-5.2"></path>
                    </svg>
                </div>
                <h3 class="cv-card-title">@L["CV.DotNet.Title"]</h3>
                <p class="cv-card-description">
                    @L["CV.DotNet.Description"]
                </p>
                <ul class="cv-highlights">
                    <li>C# & .NET Core/Framework</li>
                    <li>ASP.NET & Blazor</li>
                    <li>Azure</li>
                </ul>
                <a href="@($"{Configuration["Media:BaseUrl"]}{@L["CV.DotNet.DownloadLink"]}")" target="_blank" rel="noopener noreferrer" class="btn-cv-download">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    @L["CV.Download"]
                </a>
            </div>

            <!-- CV Full Stack -->
            <div class="cv-card">
                <div class="cv-icon fullstack">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                        <polyline points="16 10 12 14 8 10"></polyline>
                    </svg>
                </div>
                <h3 class="cv-card-title">@L["CV.FullStack.Title"]</h3>
                <p class="cv-card-description">
                    @L["CV.FullStack.Description"]
                </p>
                <ul class="cv-highlights">
                    <li>@L["CV.FullStack.Highlight1"]</li>
                    <li>@L["CV.FullStack.Highlight2"]</li>
                    <li>@L["CV.FullStack.Highlight3"]</li>
                </ul>
                <a href="@($"{Configuration["Media:BaseUrl"]}{@L["CV.FullStack.DownloadLink"]}")" target="_blank" rel="noopener noreferrer" class="btn-cv-download">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                    @L["CV.Download"]
                </a>
            </div>
        </div>
        <p class="cv-footer-note">@L["CV.FooterNote"]</p>
    </div>
</section>

<!-- Section Portfolio -->
<section id="portfolio-links" class="portfolio-section">
    <div class="section-container">
        <h2 class="section-title">@L["PortfolioSection.Title"]</h2>
        <div class="cv-intro">
            <p>@L["PortfolioSection.Intro"]</p>
        </div>

        <div class="portfolio-showcase">
            <!-- Main CTA : Portfolio Principal -->
            <div class="main-portfolio-card">
                <div class="main-content">
                    <div class="icon-wrapper">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </div>
                    <h3 class="main-title">@L["PortfolioSection.Main.Title"]</h3>
                    <p class="main-description">@L["PortfolioSection.Main.Description"]</p>
                    <a href="/portfolio" class="btn btn-primary pulse-btn">
                        @L["PortfolioSection.Main.Button"]
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-left: 8px;">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                </div>
            </div>

            <!-- Liens Secondaires -->
            <div class="secondary-portfolio-grid">
                <!-- Mes Projets -->
                <a href="/portfolio/my-projects" class="secondary-card">
                    <div class="cv-icon dotnet">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </div>
                    <div class="secondary-info">
                        <h4>@L["PortfolioSection.Projects.Title"]</h4>
                        <span class="view-link">@L["PortfolioSection.Projects.Button"] <span class="arrow">→</span></span>
                    </div>
                </a>

                <!-- Formation BUT -->
                <a href="/portfolio/but" class="secondary-card">
                    <div class="cv-icon general">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                            <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                        </svg>
                    </div>
                    <div class="secondary-info">
                        <h4>@L["PortfolioSection.But.Title"]</h4>
                        <span class="view-link">@L["PortfolioSection.But.Button"] <span class="arrow">→</span></span>
                    </div>
                </a>

                <!-- Alternance -->
                <a href="/portfolio/apprenticeship" class="secondary-card">
                    <div class="cv-icon fullstack">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                        </svg>
                    </div>
                    <div class="secondary-info">
                        <h4>@L["PortfolioSection.Apprenticeship.Title"]</h4>
                        <span class="view-link">@L["PortfolioSection.Apprenticeship.Button"] <span class="arrow">→</span></span>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>

<style>
    .portfolio-showcase {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        margin-top: 2rem;
    }
    .main-portfolio-card {
        background: linear-gradient(135deg, rgba(128, 128, 128, 0.05) 0%, rgba(0, 0, 0, 0) 100%);
        border: 1px solid rgba(128, 128, 128, 0.2);
        border-radius: 16px;
        padding: 3rem 2rem;
        text-align: center;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        color: #ffffff;
    }
    .main-portfolio-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        border-color: rgba(128, 128, 128, 0.4);
    }
    .main-portfolio-card .icon-wrapper {
        color: var(--primary, #c084fc);
        opacity: 1;
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: center;
    }
    .main-portfolio-card .main-title {
        font-size: 2rem;
        margin-bottom: 1rem;
        font-weight: 700;
        color: #ffffff;
    }
    .main-portfolio-card .main-description {
        font-size: 1.1rem;
        opacity: 0.85;
        max-width: 600px;
        margin: 0 auto 2rem;
        line-height: 1.6;
        color: #d1d5db;
    }
