        padding: 0.8rem 2.5rem;
        border-radius: 30px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }
    .secondary-portfolio-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }
    .secondary-card {
        display: flex;
        align-items: center;
        padding: 1.5rem;
        background: rgba(128, 128, 128, 0.05);
