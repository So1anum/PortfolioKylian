@page "/portfolio/but/year-3"
@layout Components.Layout.PortfolioLayout
@using PortfolioKylian.Resources
@inject LocalizationHelper L
@inject ICultureService CultureService
@implements IDisposable

<link rel="stylesheet" href="css/portfolio-shared.css" />

<PageTitle>@L["Portfolio.But.Year3.Title"] - Kylian Debonne</PageTitle>

<div class="portfolio-page">
    <header class="page-header">
        <h1 class="page-title">@L["Portfolio.But.Year3.Title"]</h1>
        <p class="page-subtitle">@L["Portfolio.But.Year3.Subtitle"]</p>
    </header>

    <div class="page-content">
        <section class="content-section">
            <h2>@L["Portfolio.But.Year3.Overview.Title"]</h2>
            <p>@L["Portfolio.But.Year3.Overview.Content"]</p>
        </section>

        <section class="content-section">
            <h2>@L["Portfolio.But.Year3.Competences.Title"]</h2>
            <div class="competences-grid">
                <a href="/portfolio/but/year-3/skill-1" class="competence-card">
                    <div class="competence-number">1</div>
                    <h3>@L["Portfolio.But.Year3.Competence1.Title"]</h3>
                    <p>@L["Portfolio.But.Year3.Competence1.Short"]</p>
                </a>

                <a href="/portfolio/but/year-3/skill-2" class="competence-card">
                    <div class="competence-number">2</div>
                    <h3>@L["Portfolio.But.Year3.Competence2.Title"]</h3>
                    <p>@L["Portfolio.But.Year3.Competence2.Short"]</p>
                </a>

                <a href="/portfolio/but/year-3/skill-3" class="competence-card">
                    <div class="competence-number">3</div>
                    <h3>@L["Portfolio.But.Year3.Competence3.Title"]</h3>
                    <p>@L["Portfolio.But.Year3.Competence3.Short"]</p>
                </a>
            </div>
        </section>

        <section class="content-section">
            <h2>@L["Portfolio.But.Year3.Research.Title"]</h2>
            <p>@L["Portfolio.But.Year3.Research.Intro"]</p>

            <div class="projects-list mt-4">
                <div class="project-item">
                    <h3>@L["Portfolio.But.Year3.Research.Workshop.Title"]</h3>
                    <p>@L["Portfolio.But.Year3.Research.Workshop.Content"]</p>
                </div>

                <div class="project-item">
                    <h3>@L["Portfolio.But.Year3.Research.Course.Title"]</h3>
                    <p>@L["Portfolio.But.Year3.Research.Course.Content"]</p>
                    <ul class="skills-list mt-3">
                        <li>@L["Portfolio.But.Year3.Research.Course.List1"]</li>
                        <li>@L["Portfolio.But.Year3.Research.Course.List2"]</li>
                    </ul>
                </div>

                <div class="project-item">
                    <h3>@L["Portfolio.But.Year3.Research.Takeaways.Title"]</h3>
                    <ul class="skills-list mt-3">
                        <li><strong class="text-white">@L["Portfolio.But.Year3.Research.Takeaways.Item1.Strong"]</strong> @L["Portfolio.But.Year3.Research.Takeaways.Item1.Text"]</li>
                        <li><strong class="text-white">@L["Portfolio.But.Year3.Research.Takeaways.Item2.Strong"]</strong> @L["Portfolio.But.Year3.Research.Takeaways.Item2.Text"]</li>
                        <li><strong class="text-white">@L["Portfolio.But.Year3.Research.Takeaways.Item3.Strong"]</strong> @L["Portfolio.But.Year3.Research.Takeaways.Item3.Text"]</li>
                        <li><strong class="text-white">@L["Portfolio.But.Year3.Research.Takeaways.Item4.Strong"]</strong> @L["Portfolio.But.Year3.Research.Takeaways.Item4.Text"]</li>
                        <li><strong class="text-white">@L["Portfolio.But.Year3.Research.Takeaways.Item5.Strong"]</strong> @L["Portfolio.But.Year3.Research.Takeaways.Item5.Text"]</li>
                    </ul>
                </div>

                <div class="project-item">
                    <h3>@L["Portfolio.But.Year3.Research.Opinion.Title"]</h3>
                    <p>@L["Portfolio.But.Year3.Research.Opinion.Content"]</p>
                </div>

                <div class="project-item">
                    <h3>@L["Portfolio.But.Year3.Research.MindMap.Title"]</h3>
                    <img src="@BuildMediaUrl(L["Portfolio.But.Year3.Research.MindMap.Path"])" alt="@L["Portfolio.But.Year3.Research.MindMap.Alt"]" style="width: 100%; border-radius: 10px; margin-top: 1rem;" />
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        CultureService.OnCultureChanged += OnCultureChanged;
    }

    private string BuildMediaUrl(string path)
    {
        var baseUrl = Configuration["Media:BaseUrl"]?.TrimEnd('/') ?? string.Empty;
        var cleanPath = path.TrimStart('/');
        return $"{baseUrl}/{cleanPath}";
    }

    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= OnCultureChanged;
    }
}
