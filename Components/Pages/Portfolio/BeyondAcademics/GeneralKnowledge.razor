@code {
    private int activeTab = 1;

    protected override void OnInitialized()
    {
        CultureService.OnCultureChanged += OnCultureChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        SetActiveTabFromUrl();
    }

    private void SetActiveTabFromUrl()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (uri.Fragment.StartsWith("#"))
        {
            if (int.TryParse(uri.Fragment.Substring(1), out int tab))
            {
                if (tab >= 1 && tab <= 3)
                {
                    activeTab = tab;
                }
            }
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        SetActiveTabFromUrl();
        InvokeAsync(StateHasChanged);
    }

    private void SetActiveTab(int tab)
    {
        activeTab = tab;
        var newUri = NavigationManager.Uri.Split('#')[0] + "#" + tab;
        // avoid forcing a full reload, replace=true ne rajoute pas une nouvelle entrée dans l'historique
        NavigationManager.NavigateTo(newUri, replace: true);
    }

    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= OnCultureChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
