@page "/portfolio/beyond-academics/sports"
@layout Components.Layout.PortfolioLayout
@using PortfolioKylian.Resources
@inject LocalizationHelper L
@inject ICultureService CultureService
@implements IDisposable

<link rel="stylesheet" href="css/portfolio-shared.css" />

<PageTitle>@L["Portfolio.BeyondAcademics.Sport.Title"] - Kylian Debonne</PageTitle>

<div class="portfolio-page">
    <header class="page-header">
        <h1 class="page-title">@L["Portfolio.BeyondAcademics.Sport.Title"]</h1>
        <p class="page-subtitle">@L["Portfolio.BeyondAcademics.Sport.Subtitle"]</p>
    </header>

    <div class="page-content">
        <section class="content-section">
            <h2>@L["Portfolio.BeyondAcademics.Sport.Intro.Title"]</h2>
            <p>@L["Portfolio.BeyondAcademics.Sport.Intro.Content"]</p>
        </section>

        <section class="content-section">
            <h2>@L["Portfolio.BeyondAcademics.Sport.Activities.Title"]</h2>
            <div class="activities-grid">
                <div class="activity-card">
                    <h3>@L["Portfolio.BeyondAcademics.Sport.Activity1.Title"]</h3>
                    <p>@L["Portfolio.BeyondAcademics.Sport.Activity1.Content"]</p>
                    <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/BeyondAcademics/Sport/semi_marathon.jpg")" alt="photo de nous au semi marathon de laval 2025" />
                </div>

                <div class="activity-card">
                    <h3>@L["Portfolio.BeyondAcademics.Sport.Activity2.Title"]</h3>
                    <p>@L["Portfolio.BeyondAcademics.Sport.Activity2.Content"]</p>
                    <div class="activity-logos-container">
                        <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/BeyondAcademics/Sport/tennis_de_table.jpg")" alt="image de tennis de table" class="activity-logo" />
                        <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/BeyondAcademics/Sport/agcv.jpg")" alt="logo de mon club" class="activity-logo" />
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        CultureService.OnCultureChanged += OnCultureChanged;
    }

    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= OnCultureChanged;
    }
}
