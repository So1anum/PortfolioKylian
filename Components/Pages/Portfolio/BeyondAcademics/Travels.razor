@page "/portfolio/beyond-academics/travels"
@layout Components.Layout.PortfolioLayout
@using PortfolioKylian.Resources
@inject LocalizationHelper L
@inject ICultureService CultureService
@implements IDisposable

<link rel="stylesheet" href="css/portfolio-shared.css" />
<link rel="stylesheet" href="css/travels-timeline.css" />

<PageTitle>@L["Portfolio.BeyondAcademics.Travels.Title"] - Kylian Debonne</PageTitle>

<div class="portfolio-page">
    <header class="page-header">
        <h1 class="page-title">@L["Portfolio.BeyondAcademics.Travels.Title"]</h1>
        <p class="page-subtitle">@L["Portfolio.BeyondAcademics.Travels.Subtitle"]</p>
    </header>

    <div class="page-content">
        <section class="content-section">
            <h2>@L["Portfolio.BeyondAcademics.Travels.Intro.Title"]</h2>
            <p>@L["Portfolio.BeyondAcademics.Travels.Intro.Content"]</p>
        </section>

        <section class="content-section">
            <h2>@L["Portfolio.BeyondAcademics.Travels.Timeline.Title"]</h2>
            <div class="travels-timeline">
                @foreach (var voyage in voyages)
                {
                    <div class="timeline-item @(activeVoyageId == voyage.Id ? "active" : "")" 
                         @onclick="() => ToggleVoyage(voyage.Id)">
                        <div class="timeline-dot"></div>
                        <div class="travel-card">
                            <div class="travel-header">
                                <div class="travel-flag">
                                    <img src="https://flagcdn.com/w80/@(L[$"Portfolio.BeyondAcademics.Travels.Voyage{voyage.Id}.FlagCode"]).png" 
                                         alt="@L[$"Portfolio.BeyondAcademics.Travels.Voyage{voyage.Id}.Country"]"
                                         class="flag-image" />
                                </div>
                                <div class="travel-title">
                                    <h3 class="travel-city">@L[$"Portfolio.BeyondAcademics.Travels.Voyage{voyage.Id}.City"]</h3>
                                    <p class="travel-country">@L[$"Portfolio.BeyondAcademics.Travels.Voyage{voyage.Id}.Country"]</p>
                                </div>
                            </div>

                            <div class="travel-meta">
                                <span class="travel-date">@L[$"Portfolio.BeyondAcademics.Travels.Voyage{voyage.Id}.Date"]</span>
                                <span class="travel-duration">@L[$"Portfolio.BeyondAcademics.Travels.Voyage{voyage.Id}.Duration"]</span>
                            </div>

                            <div class="travel-expandable">
                                <p class="travel-description">
                                    @L[$"Portfolio.BeyondAcademics.Travels.Voyage{voyage.Id}.Description"]
                                </p>

                                <div class="travel-highlights">
                                    <span class="highlight-tag">@L[$"Portfolio.BeyondAcademics.Travels.Voyage{voyage.Id}.Highlight1"]</span>
                                    <span class="highlight-tag">@L[$"Portfolio.BeyondAcademics.Travels.Voyage{voyage.Id}.Highlight2"]</span>
                                    <span class="highlight-tag">@L[$"Portfolio.BeyondAcademics.Travels.Voyage{voyage.Id}.Highlight3"]</span>
                                </div>

                                @if (voyage.Photos.Any())
                                {
                                    <div class="travel-gallery">
                                        @foreach (var photo in voyage.Photos)
                                        {
                                            <div class="travel-photo" @onclick="() => OpenLightbox(voyage.Id, photo)" @onclick:stopPropagation="true">
                                                <img src="@photo.Path" alt="@photo.Alt" loading="lazy" />
                                                <div class="photo-overlay">
                                                    <span class="photo-zoom-icon">🔍</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="expand-indicator">
                                <span>@(activeVoyageId == voyage.Id ? "Réduire" : "Voir plus")</span>
                                <span class="expand-icon">▼</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    </div>
</div>

@* Lightbox Modal *@
@if (lightboxPhoto != null)
{
    <div class="lightbox-overlay" @onclick="CloseLightbox">
        <div class="lightbox-container" @onclick:stopPropagation="true">
            <button class="lightbox-close" @onclick="CloseLightbox" aria-label="Fermer">✕</button>

            @if (currentVoyagePhotos.Count > 1)
            {
                <button class="lightbox-nav lightbox-prev" @onclick="PreviousPhoto" aria-label="Photo précédente">❮</button>
                <button class="lightbox-nav lightbox-next" @onclick="NextPhoto" aria-label="Photo suivante">❯</button>
            }

            <div class="lightbox-content">
                <img src="@lightboxPhoto.Path" alt="@lightboxPhoto.Alt" />
                @if (!string.IsNullOrEmpty(lightboxPhoto.Caption))
                {
                    <div class="lightbox-caption">@lightboxPhoto.Caption</div>
                }
            </div>

            @if (currentVoyagePhotos.Count > 1)
            {
                <div class="lightbox-counter">
                    @(currentPhotoIndex + 1) / @currentVoyagePhotos.Count
                </div>
            }
        </div>
    </div>
}

