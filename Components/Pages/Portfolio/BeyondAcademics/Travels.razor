    private void ToggleVoyage(int voyageId)
    {
        if (activeVoyageId == voyageId)
        {
            activeVoyageId = null;
        }
        else
        {
            activeVoyageId = voyageId;
        }
    }

    private void OpenLightbox(int voyageId, PhotoInfo photo)
    {
        var voyage = voyages.FirstOrDefault(v => v.Id == voyageId);
        if (voyage != null)
        {
            currentVoyagePhotos = voyage.Photos;
            currentPhotoIndex = currentVoyagePhotos.IndexOf(photo);
            lightboxPhoto = photo;
        }
    }

    private void CloseLightbox()
    {
        lightboxPhoto = null;
        currentVoyagePhotos = new();
        currentPhotoIndex = 0;
    }

    private void NextPhoto()
    {
        if (currentVoyagePhotos.Any())
        {
            currentPhotoIndex = (currentPhotoIndex + 1) % currentVoyagePhotos.Count;
            lightboxPhoto = currentVoyagePhotos[currentPhotoIndex];
        }
    }

    private void PreviousPhoto()
    {
        if (currentVoyagePhotos.Any())
        {
            currentPhotoIndex = (currentPhotoIndex - 1 + currentVoyagePhotos.Count) % currentVoyagePhotos.Count;
            lightboxPhoto = currentVoyagePhotos[currentPhotoIndex];
        }
    }

    private void OnCultureChanged()
    {
        InitializeVoyages();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= OnCultureChanged;
    }

    private class TravelInfo
    {
        public int Id { get; set; }
        public List<PhotoInfo> Photos { get; set; } = new();
    }

    private class PhotoInfo
    {
        public string Path { get; set; } = string.Empty;
        public string Alt { get; set; } = string.Empty;
        public string Caption { get; set; } = string.Empty;
    }
