@page "/portfolio/pre-but/death-ire"
@layout Components.Layout.PortfolioLayout
@using PortfolioKylian.Resources
@using PortfolioKylian.Models
@inject LocalizationHelper L
@inject ICultureService CultureService
@implements IDisposable

<link rel="stylesheet" href="css/portfolio-shared.css" />

<PageTitle>@L["Portfolio.DeathIre.Title"] - Kylian Debonne</PageTitle>

<div class="portfolio-page">
    <header class="page-header">
        <h1 class="page-title">@L["Portfolio.DeathIre.Title"]</h1>
        <p class="page-subtitle">@L["Portfolio.DeathIre.Subtitle"]</p>
    </header>

    <div class="page-content">
        <!-- Intro Section -->
        <section class="content-section">
            <h2>@L["Portfolio.DeathIre.Intro.Title"]</h2>
            <p>@L["Portfolio.DeathIre.Intro.Description"]</p>
        </section>

        <!-- Game Explanation Section -->
        <section class="content-section">
            <div class="row align-items-center">
                <div class="col-md-7 mb-3 mb-md-0">
                    <h2>@L["Portfolio.DeathIre.GameExpl.Title"]</h2>
                    <p>@L["Portfolio.DeathIre.GameExpl.Description"]</p>
                </div>
                <div class="col-md-5 text-center">
                    <video src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/DeathIre/Gameplay_RedmiNote11Pro.mp4")" 
                           class="img-fluid rounded shadow" 
                           controls muted loop preload="metadata"
                           style="max-height: 400px; border: 1px solid rgba(147, 51, 234, 0.2);">
                        @L["VideoError"]
                    </video>
                </div>
            </div>
        </section>

        <!-- Game Design & Menus Section (Carousel) -->
        <section class="content-section carousel-section deathire-carousel-section">
            <h2>@L["Portfolio.DeathIre.GameDesign.Title"]</h2>
            <p>@L["Portfolio.DeathIre.GameDesign.Description"]</p>

            <div class="image-carousel mb-4 mt-3">
                <button class="carousel-button carousel-prev" @onclick="PreviousImage" aria-label="Image précédente">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
                
                <div class="carousel-container">
                    <div class="carousel-track" style="transform: translateX(-@(currentImageIndex * 100)%);">
                        @foreach (var media in carouselImages)
                        {
                            <div class="carousel-slide">
                                @if (media.IsVideo)
                                {
                                    <video src="@BuildMediaUrl(media.Url)" class="carousel-image carousel-video"
                                           controls muted loop preload="metadata"
                                           @key="@media.Url">
                                        @L["VideoError"]
                                    </video>
                                }
                                else
                                {
                                    <img src="@BuildMediaUrl(media.Url)" alt="@L[media.AltKey]" class="carousel-image" loading="lazy" />
                                }
                                @if (!string.IsNullOrEmpty(media.CaptionKey))
                                {
                                    <div class="carousel-caption">
                                        <p>@L[media.CaptionKey]</p>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                
                <button class="carousel-button carousel-next" @onclick="NextImage" aria-label="Image suivante">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>

                <div class="carousel-indicators">
                    @for (int i = 0; i < carouselImages.Count; i++)
                    {
                        var index = i;
                        <button 
                            class="carousel-indicator @(currentImageIndex == index ? "active" : "")" 
                            @onclick="() => GoToImage(index)"
                            aria-label="Aller à l'image @(index + 1)">
                        </button>
                    }
                </div>
            </div>
        </section>

        <!-- Level Generation Section -->
        <section class="content-section">
            <div class="row align-items-center flex-row-reverse">
                <div class="col-md-7 mb-3 mb-md-0">
                    <h2>@L["Portfolio.DeathIre.LevelGen.Title"]</h2>
                    <p>@L["Portfolio.DeathIre.LevelGen.Description"]</p>
                </div>
                <div class="col-md-5 text-center">
                    <video src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/DeathIre/DeathIre_Load_Level.mp4")" 
                           class="img-fluid rounded shadow" 
                           controls muted loop preload="metadata"
                           style="border: 1px solid rgba(147, 51, 234, 0.2);">
                        @L["VideoError"]
                    </video>
                </div>
            </div>
        </section>

        <!-- Conclusion Section -->
        <section class="content-section">
            <h2>@L["Portfolio.DeathIre.Conclusion.Title"]</h2>
            <div class="row align-items-center mt-3">
                <div class="col-md-7 mb-3 mb-md-0">
                    <p>@L["Portfolio.DeathIre.Conclusion.Description"]</p>
                    <div class="mt-4 text-center">
                        <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/DeathIre/CaptureUnity3.png")" alt="Aperçu du jeu Boss" class="img-fluid rounded shadow" style="max-height: 250px; border: 1px solid rgba(147, 51, 234, 0.2);" />
                    </div>
                </div>
                <div class="col-md-5 text-center">
                    <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/DeathIre/Code_MovePlayer.png")" alt="Extrait de code du mouvement du personnage" class="img-fluid rounded shadow" style="max-height: 400px; border: 1px solid rgba(147, 51, 234, 0.2);" />
                </div>
            </div>
        </section>
    </div>
</div>

<style>
    .deathire-carousel-section .carousel-video::-webkit-media-controls-panel {
        background: transparent;
    }
</style>

@code {
    private int currentImageIndex = 0;

    private List<CarouselItem> carouselImages = new()
    {
        new CarouselItem 
        { 
            Url = "images/portfolio/PreBUT/DeathIre/DeathIre_MainMenu.mp4", 
            AltKey = "Portfolio.DeathIre.GameDesign.Carousel.Item1Alt" 
        },
        new CarouselItem 
        { 
            Url = "images/portfolio/PreBUT/DeathIre/CaptureUnity1.png", 
            AltKey = "Portfolio.DeathIre.GameDesign.Carousel.Item2Alt", 
            CaptionKey = "Portfolio.DeathIre.GameDesign.Carousel.Item2Cap"
        },
        new CarouselItem 
        { 
            Url = "images/portfolio/PreBUT/DeathIre/CaptureUnity2.png", 
            AltKey = "Portfolio.DeathIre.GameDesign.Carousel.Item3Alt", 
            CaptionKey = "Portfolio.DeathIre.GameDesign.Carousel.Item3Cap"
        }
    };

    protected override void OnInitialized()
    {
        CultureService.OnCultureChanged += OnCultureChanged;
    }

    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private string BuildMediaUrl(string path)
    {
        var baseUrl = Configuration["Media:BaseUrl"]?.TrimEnd('/') ?? string.Empty;
        var cleanPath = path.TrimStart('/');
        return $"{baseUrl}/{cleanPath}";
    }

    private void NextImage()
    {
        currentImageIndex = (currentImageIndex + 1) % carouselImages.Count;
    }

    private void PreviousImage()
    {
        currentImageIndex = currentImageIndex == 0 ? carouselImages.Count - 1 : currentImageIndex - 1;
    }

    private void GoToImage(int index)
    {
        currentImageIndex = index;
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= OnCultureChanged;
    }
}
