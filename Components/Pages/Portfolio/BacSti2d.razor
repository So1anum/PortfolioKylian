@page "/portfolio/my-projects/bac-sti2d"
@layout Components.Layout.PortfolioLayout
@using PortfolioKylian.Resources
@inject LocalizationHelper L
@inject ICultureService CultureService
@implements IDisposable

<link rel="stylesheet" href="css/portfolio-shared.css" />

<PageTitle>@L["Portfolio.BacSti2d.Title"] - Kylian Debonne</PageTitle>

<div class="portfolio-page">
    <header class="page-header">
        <h1 class="page-title">@L["Portfolio.BacSti2d.Title"]</h1>
        <p class="page-subtitle">@L["Portfolio.BacSti2d.Subtitle"]</p>
    </header>

    <div class="page-content">
        <!-- Intro Section -->
        <section class="content-section">
            <div class="row align-items-center">
                <div class="col-md-8 mb-3 mb-md-0">
                    <h2>@L["Portfolio.BacSti2d.Intro.Title"]</h2>
                    <p>@L["Portfolio.BacSti2d.Intro.Description"]</p>
                </div>
                <div class="col-md-4 text-center">
                    <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/kart_pc.jpg")" alt="@L["Portfolio.BacSti2d.Title"]" class="img-fluid rounded shadow" style="max-height: 250px; border: 1px solid rgba(147, 51, 234, 0.2);" />
                </div>
            </div>
        </section>

        <!-- System and Architecture Section -->
        <section class="content-section">
            <h2>@L["Portfolio.BacSti2d.System.Title"]</h2>
            <p>@L["Portfolio.BacSti2d.System.Description"]</p>
            <div class="row mt-4">
                <div class="col-12 col-lg-6 mb-4 text-center">
                    <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/Schéma_ensemble.jpg")" alt="@L["Portfolio.BacSti2d.Alt.SchemaEnsemble"]" class="img-fluid rounded shadow" style="border: 1px solid rgba(147, 51, 234, 0.2);" />
                </div>
                <div class="col-12 col-lg-6 mb-4 text-center">
                    <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/Schema_electrique.png")" alt="@L["Portfolio.BacSti2d.Alt.SchemaElec"]" class="img-fluid rounded shadow" style="border: 1px solid rgba(147, 51, 234, 0.2);" />
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-12 col-lg-6 mb-4 text-center">
                    <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/bdd.png")" alt="@L["Portfolio.BacSti2d.Alt.Bdd"]" class="img-fluid rounded shadow" style="border: 1px solid rgba(147, 51, 234, 0.2);" />
                </div>
                <div class="col-12 col-lg-6 mb-4 text-center">
                    <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/bdi.jpg")" alt="@L["Portfolio.BacSti2d.Alt.Bdi"]" class="img-fluid rounded shadow" style="border: 1px solid rgba(147, 51, 234, 0.2);" />
                </div>
            </div>
        </section>

        <!-- Software Application Section -->
        <section class="content-section">
            <div class="row align-items-center flex-row-reverse">
                <div class="col-md-8 mb-3 mb-md-0">
                    <h2>@L["Portfolio.BacSti2d.Software.Title"]</h2>
                    <p>@L["Portfolio.BacSti2d.Software.Description"]</p>
                </div>
                <div class="col-md-4 text-center">
                    <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/IHM_Conduite.png")" alt="@L["Portfolio.BacSti2d.Alt.IhmConduite"]" class="img-fluid rounded shadow" style="max-height: 400px; border: 1px solid rgba(147, 51, 234, 0.2);" />
                </div>
            </div>
            <div class="row mt-4">
                <div class="col-12 text-center">
                    <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/capture_unity_project.PNG")" alt="@L["Portfolio.BacSti2d.Alt.UnityProject"]" class="img-fluid rounded shadow" style="max-height: 400px; border: 1px solid rgba(147, 51, 234, 0.2);" />
                </div>
            </div>
        </section>

        <!-- Videos Section -->
        <section class="content-section">
            <h2>@L["Portfolio.BacSti2d.Videos.Title"]</h2>
            <p>@L["Portfolio.BacSti2d.Videos.Description"]</p>
            <div class="row mt-4">
                <div class="col-12 col-md-6 mb-4 text-center">
                    <video src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/video_kart.mp4")" 
                           class="img-fluid rounded shadow" 
                           controls muted loop preload="metadata"
                           style="border: 1px solid rgba(147, 51, 234, 0.2);">
                        @L["VideoError"]
                    </video>
                </div>
                <div class="col-12 col-md-6 mb-4 text-center">
                    <video src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/video_verin.mp4")" 
                           class="img-fluid rounded shadow" 
                           controls muted loop preload="metadata"
                           style="border: 1px solid rgba(147, 51, 234, 0.2);">
                        @L["VideoError"]
                    </video>
                </div>
            </div>
        </section>

        <!-- Project Management (Gantt) Section -->
        <section class="content-section">
            <h2>@L["Portfolio.BacSti2d.Management.Title"]</h2>
            <p>@L["Portfolio.BacSti2d.Management.Description"]</p>
            <div class="text-center mt-4">
                @if (CultureService.GetCurrentCultureCode().ToLower() == "en")
                {
                    <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/english_gantt.png")" alt="@L["Portfolio.BacSti2d.Alt.Gantt"]" class="img-fluid rounded shadow" style="border: 1px solid rgba(147, 51, 234, 0.2);" />
                }
                else
                {
                    <img src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/Gantt.png")" alt="@L["Portfolio.BacSti2d.Alt.Gantt"]" class="img-fluid rounded shadow" style="border: 1px solid rgba(147, 51, 234, 0.2);" />
                }
            </div>
        </section>

        <!-- Document Section -->
        <section class="content-section">
            <h2>@L["Portfolio.BacSti2d.Document.Title"]</h2>
            <p class="text-info">@L["Portfolio.BacSti2d.Document.Notice"]</p>
            <div class="document-container mt-4" style="height: 800px; border: 1px solid rgba(147, 51, 234, 0.2); border-radius: 12px; overflow: hidden;">
                <iframe src="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/Dossier%20soutenance%20Kylian%20Debonne.pdf")" width="100%" height="100%" style="border: none;">
                    Ce navigateur ne supporte pas l'affichage des PDF. Veuillez télécharger le document.
                </iframe>
            </div>
            <div class="text-center mt-3">
                <a href="@($"{Configuration["Media:BaseUrl"]}images/portfolio/PreBUT/kart/Dossier%20soutenance%20Kylian%20Debonne.pdf")" target="_blank" class="cyber-button">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    @L["CV.Download"]
                </a>
            </div>
        </section>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        CultureService.OnCultureChanged += OnCultureChanged;
    }

    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= OnCultureChanged;
    }
}
