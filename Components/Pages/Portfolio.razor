@page "/portfolio"
@layout Components.Layout.MainLayout

<PageTitle>Portfolio - Kylian Debonne</PageTitle>

<div class="portfolio-page">
    <div class="portfolio-container">
        <h1 class="portfolio-title">Mon Portfolio</h1>
        <p class="portfolio-subtitle">Découvrez mes projets et réalisations</p>
        
        <div class="projects-grid">
            <div class="project-card">
                <div class="project-image">
                    <div class="project-placeholder">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </div>
                </div>
                <div class="project-content">
                    <h3 class="project-title">Projet 1</h3>
                    <p class="project-description">
                        Description du projet à venir...
                    </p>
                    <div class="project-tags">
                        <span class="tag">C#</span>
                        <span class="tag">Blazor</span>
                        <span class="tag">.NET</span>
                    </div>
                </div>
            </div>

            <div class="project-card">
                <div class="project-image">
                    <div class="project-placeholder">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </div>
                </div>
                <div class="project-content">
                    <h3 class="project-title">Projet 2</h3>
                    <p class="project-description">
                        Description du projet à venir...
                    </p>
                    <div class="project-tags">
                        <span class="tag">ASP.NET</span>
                        <span class="tag">Azure</span>
                    </div>
                </div>
            </div>

            <div class="project-card">
                <div class="project-image">
                    <div class="project-placeholder">
                        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </div>
                </div>
                <div class="project-content">
                    <h3 class="project-title">Projet 3</h3>
                    <p class="project-description">
                        Description du projet à venir...
                    </p>
                    <div class="project-tags">
                        <span class="tag">SQL</span>
                        <span class="tag">API</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="back-button">
            <a href="/" class="btn btn-primary">← Retour à l'accueil</a>
        </div>
    </div>
</div>
