@page "/portfolio"
@layout Components.Layout.FullScreenLayout
@using PortfolioKylian.Components.Layout
@using PortfolioKylian.Resources
@inject LocalizationHelper L
@inject ICultureService CultureService
@implements IDisposable

<PageTitle>@L["Portfolio.Title"] - Kylian Debonne</PageTitle>

<Header @rendermode="InteractiveServer" />

<section class="portfolio-section">
    <div class="portfolio-content">
        <div class="portfolio-visual">
            <div class="construction-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                </svg>
            </div>
        </div>
        
        <div class="portfolio-text">
            <h1 class="portfolio-title">@L["Portfolio.Title"]</h1>
            <p class="portfolio-subtitle">@L["Portfolio.Subtitle"]</p>
            <p class="portfolio-description">@L["Portfolio.Message"]</p>
            <div class="portfolio-badge">
                <span>@L["Portfolio.ComingSoon"]</span>
            </div>
            <div class="portfolio-actions">
                <a href="/" class="btn btn-primary">@L["Portfolio.BackToHome"]</a>
                <a href="/#contact" class="btn btn-secondary">@L["Header.Contact"]</a>
            </div>
        </div>
    </div>
</section>

<footer class="site-footer">
    <div class="footer-content">
        <div class="footer-links">
            <a href="https://github.com/So1anum" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/kylian-debonne-5b359a3b3/" target="_blank" rel="noopener">LinkedIn</a>
        </div>
    </div>
</footer>

@code {
    protected override void OnInitialized()
    {
        CultureService.OnCultureChanged += OnCultureChanged;
        L.OnLanguageChanged += OnLanguageChanged;
    }

    private void OnCultureChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= OnCultureChanged;
        L.OnLanguageChanged -= OnLanguageChanged;
    }
}
