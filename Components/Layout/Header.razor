@using PortfolioKylian.Resources
@inject LocalizationHelper L
@inject ICultureService CultureService
@implements IDisposable

<header class="main-header">
    <nav class="navbar">
        <div class="navbar-container">
            <div class="header-left">
                @LeftContent
                <a href="/" class="navbar-brand">Kylian Debonne</a>
            </div>

            <button class="navbar-toggler" @onclick="ToggleMenu">
                <span class="toggler-icon"></span>
                <span class="toggler-icon"></span>
                <span class="toggler-icon"></span>
            </button>

            <ul class="navbar-menu @(isMenuOpen ? "active" : "")">
                <li><a href="/#presentation" @onclick="CloseMenu">@L["Header.Presentation"]</a></li>
                <li><a href="/#about" @onclick="CloseMenu">@L["Header.About"]</a></li>
                <li><a href="/#languages" @onclick="CloseMenu">@L["Header.Languages"]</a></li>
                <li><a href="/#skills" @onclick="CloseMenu">@L["Header.Skills"]</a></li>
                <li><a href="/#education" @onclick="CloseMenu">@L["Header.Education"]</a></li>
                <li><a href="/#cv" @onclick="CloseMenu">@L["Header.CV"]</a></li>
                <li><a href="/portfolio" @onclick="CloseMenu">@L["Header.Portfolio"]</a></li>
                <li><a href="/#contact" @onclick="CloseMenu" class="btn-contact">@L["Header.Contact"]</a></li>
                <li class="language-switcher-item">
                    <div class="language-switcher">
                        <button class="lang-btn @(currentLang == "fr" ? "active" : "")" 
                                @onclick="SwitchToFrench"
                                title="Français">
                            <img src="https://flagcdn.com/w20/fr.png" alt="Français" class="flag" />
                        </button>
                        <button class="lang-btn @(currentLang == "en" ? "active" : "")" 
                                @onclick="SwitchToEnglish"
                                title="English">
                            <img src="https://flagcdn.com/w20/gb.png" alt="English" class="flag" />
                        </button>
                    </div>
                </li>
            </ul>
        </div>
    </nav>
</header>

@code {
    [Parameter]
    public RenderFragment? LeftContent { get; set; }

    private bool isMenuOpen = false;
    private string currentLang = "fr";

    protected override void OnInitialized()
    {
        currentLang = CultureService.GetCurrentCultureCode();
        CultureService.OnCultureChanged += OnCultureChanged;
        L.OnLanguageChanged += OnLanguageChanged;
    }

    private async Task SwitchToFrench()
    {
        await CultureService.SetCultureAsync("fr-FR");
        currentLang = CultureService.GetCurrentCultureCode();
        StateHasChanged();
    }

    private async Task SwitchToEnglish()
    {
        await CultureService.SetCultureAsync("en-US");
        currentLang = CultureService.GetCurrentCultureCode();
        StateHasChanged();
    }

    private void OnCultureChanged()
    {
        currentLang = CultureService.GetCurrentCultureCode();
        InvokeAsync(StateHasChanged);
    }

    private void OnLanguageChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    private void CloseMenu()
    {
        isMenuOpen = false;
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= OnCultureChanged;
        L.OnLanguageChanged -= OnLanguageChanged;
    }
}
