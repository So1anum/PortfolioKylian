@inherits LayoutComponentBase
@using PortfolioKylian.Resources
@using PortfolioKylian.Components.Layout
@inject LocalizationHelper L
@inject ICultureService CultureService
@inject NavigationManager Navigation
@implements IDisposable

<Header @rendermode="InteractiveServer" />

<div class="portfolio-layout">
    <aside class="portfolio-sidebar @(isSidebarOpen ? "open" : "")">
        <button class="sidebar-toggle" @onclick="ToggleSidebar">
            <span class="toggle-icon"></span>
        </button>
        
        <nav class="sidebar-nav">
            <a href="/portfolio" class="nav-item @(IsActive("/portfolio"))">
                <span class="nav-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                </span>
                <span class="nav-text">@L["Portfolio.Nav.Home"]</span>
            </a>

            <div class="nav-group">
                <button class="nav-item group-toggle @(IsActive("/portfolio/my-projects"))" @onclick="ToggleMyProjectsMenu">
                    <span class="nav-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                            <path d="M2 17l10 5 10-5"></path>
                            <path d="M2 12l10 5 10-5"></path>
                        </svg>
                    </span>
                    <span class="nav-text">@L["Portfolio.Nav.PreBut"]</span>
                    <span class="chevron @(isMyProjectsMenuOpen ? "open" : "")">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </span>
                </button>

                <div class="nav-submenu @(isMyProjectsMenuOpen ? "open" : "")">
                    <a href="/portfolio/my-projects" class="nav-subitem @(IsExactActive("/portfolio/my-projects"))">@L["Portfolio.Nav.PreBut.Hub"]</a>
                    <a href="/portfolio/my-projects/aspi-hotel-booking" class="nav-subitem @(IsActive("/portfolio/my-projects/aspi-hotel-booking"))">@L["Portfolio.Nav.PreBut.AspiHotel"]</a>
                    <a href="/portfolio/my-projects/scratch" class="nav-subitem @(IsActive("/portfolio/my-projects/scratch"))">@L["Portfolio.Nav.PreBut.Scratch"]</a>
                    <a href="/portfolio/my-projects/arduino-pc" class="nav-subitem @(IsActive("/portfolio/my-projects/arduino-pc"))">@L["Portfolio.Nav.PreBut.ArduinoPc"]</a>
                    <a href="/portfolio/my-projects/death-ire" class="nav-subitem @(IsActive("/portfolio/my-projects/death-ire"))">@L["Portfolio.Nav.PreBut.DeathIre"]</a>
                    <a href="/portfolio/my-projects/bac-sti2d" class="nav-subitem @(IsActive("/portfolio/my-projects/bac-sti2d"))">@L["Portfolio.Nav.PreBut.Bac"]</a>
                </div>
            </div>

            <div class="nav-group">
                <button class="nav-item group-toggle @(IsActive("/portfolio/but"))" @onclick="ToggleButMenu">
                    <span class="nav-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                        </svg>
                    </span>
                    <span class="nav-text">@L["Portfolio.Nav.But"]</span>
                    <span class="chevron @(isButMenuOpen ? "open" : "")">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </span>
                </button>
                
                <div class="nav-submenu @(isButMenuOpen ? "open" : "")">
                    <a href="/portfolio/but/year-1" class="nav-subitem @(IsActive("/portfolio/but/year-1"))">@L["Portfolio.Nav.Year1"]</a>
                    <a href="/portfolio/but/year-2" class="nav-subitem @(IsActive("/portfolio/but/year-2"))">@L["Portfolio.Nav.Year2"]</a>
                    <a href="/portfolio/but/year-3" class="nav-subitem @(IsActive("/portfolio/but/year-3"))">@L["Portfolio.Nav.Year3"]</a>
                </div>
            </div>

            <a href="/portfolio/apprenticeship" class="nav-item @(IsActive("/portfolio/apprenticeship"))">
                <span class="nav-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                </span>
                <span class="nav-text">@L["Portfolio.Nav.Apprenticeship"]</span>
            </a>

            <a href="/portfolio/post-but" class="nav-item @(IsActive("/portfolio/post-but"))">
                <span class="nav-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                        <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                    </svg>
                </span>
                <span class="nav-text">@L["Portfolio.Nav.PostBut"]</span>
            </a>

            <a href="/portfolio/game-engines" class="nav-item @(IsActive("/portfolio/game-engines"))">
                <span class="nav-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="6" y1="12" x2="10" y2="12"></line>
                        <line x1="8" y1="10" x2="8" y2="14"></line>
                        <line x1="15" y1="13" x2="15.01" y2="13"></line>
                        <line x1="18" y1="11" x2="18.01" y2="11"></line>
                        <rect x="2" y="6" width="20" height="12" rx="2" ry="2"></rect>
                    </svg>
                </span>
                <span class="nav-text">@L["Portfolio.Nav.GameEngines"]</span>
            </a>

            <div class="nav-group">
                <button class="nav-item group-toggle @(IsActive("/portfolio/beyond-academics"))" @onclick="ToggleHorsLesMursMenu">
                    <span class="nav-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                        </svg>
                    </span>
                    <span class="nav-text">@L["Portfolio.Nav.BeyondAcademics"]</span>
                    <span class="chevron @(isHorsLesMursMenuOpen ? "open" : "")">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"></polyline>
                        </svg>
                    </span>
                </button>
                
                <div class="nav-submenu @(isHorsLesMursMenuOpen ? "open" : "")">
                    <a href="/portfolio/beyond-academics/general-knowledge" class="nav-subitem @(IsActive("/portfolio/beyond-academics/general-knowledge"))">@L["Portfolio.Nav.GeneralKnowledge"]</a>
                    <a href="/portfolio/beyond-academics/sports" class="nav-subitem @(IsActive("/portfolio/beyond-academics/sports"))">@L["Portfolio.Nav.Sports"]</a>
                    <a href="/portfolio/beyond-academics/travels" class="nav-subitem @(IsActive("/portfolio/beyond-academics/travels"))">@L["Portfolio.Nav.Travels"]</a>
                </div>
            </div>
        </nav>
    </aside>

    <main class="portfolio-main">
        @Body
    </main>
</div>

@code {
private bool isSidebarOpen = true;
private bool isMyProjectsMenuOpen = false;
private bool isButMenuOpen = true;
private bool isHorsLesMursMenuOpen = false;

protected override void OnInitialized()
{
    CultureService.OnCultureChanged += OnCultureChanged;
    Navigation.LocationChanged += OnLocationChanged;
    UpdateMenuState();
}

private void OnCultureChanged()
{
    InvokeAsync(StateHasChanged);
}

private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
{
    UpdateMenuState();
    InvokeAsync(StateHasChanged);
}

private void UpdateMenuState()
{
    var currentUrl = Navigation.Uri;
    if (currentUrl.Contains("/portfolio/my-projects"))
    {
        isMyProjectsMenuOpen = true;
    }
    if (currentUrl.Contains("/portfolio/but"))
    {
        isButMenuOpen = true;
    }
    if (currentUrl.Contains("/portfolio/beyond-academics"))
    {
        isHorsLesMursMenuOpen = true;
    }
}

private void ToggleSidebar()
{
    isSidebarOpen = !isSidebarOpen;
}

private void ToggleMyProjectsMenu()
{
    isMyProjectsMenuOpen = !isMyProjectsMenuOpen;
}

private void ToggleButMenu()
{
    isButMenuOpen = !isButMenuOpen;
}

    private void ToggleHorsLesMursMenu()
    {
        isHorsLesMursMenuOpen = !isHorsLesMursMenuOpen;
    }

    private string IsActive(string path)
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;

        if (path == "/portfolio")
        {
            return currentPath == "/portfolio" ? "active" : "";
        }

        return currentPath.StartsWith(path) ? "active" : "";
    }

    private string IsExactActive(string path)
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;

        return currentPath == path ? "active" : "";
    }

    public void Dispose()
    {
        CultureService.OnCultureChanged -= OnCultureChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
