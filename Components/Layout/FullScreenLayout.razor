@inherits LayoutComponentBase
@using PortfolioKylian.Components.Shared
@inject ICultureService CultureService

<ToastContainer @rendermode="InteractiveServer" />

<div class="full-screen-layout">
    @Body
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CultureService.InitializeAsync();
        }
    }
}

<script>
    // Smooth scroll pour les ancres
    document.addEventListener('DOMContentLoaded', function() {
        // Gérer les liens d'ancre
        document.addEventListener('click', function(e) {
            const target = e.target.closest('a[href*="#"]');
            if (target && target.hash) {
                const href = target.getAttribute('href');

                // Si c'est un lien vers la page d'accueil avec ancre (ex: /#about)
                if (href.startsWith('/#') || href.startsWith('#')) {
                    const hash = href.includes('#') ? href.split('#')[1] : '';
                    const currentPath = window.location.pathname;

                    // Si on est déjà sur la page d'accueil, faire un smooth scroll
                    if (currentPath === '/' || currentPath === '') {
                        e.preventDefault();
                        const element = document.getElementById(hash);

                        if (element) {
                            // Fermer le menu mobile si ouvert
                            const menu = document.querySelector('.navbar-menu');
                            if (menu) {
                                menu.classList.remove('active');
                            }

                            // Scroll vers l'élément
                            element.scrollIntoView({
                                behavior: 'smooth',
                                block: 'start'
                            });

                            // Mettre à jour l'URL sans recharger
                            history.pushState(null, null, '#' + hash);
                        }
                    }
                    // Sinon, laisser le navigateur rediriger vers la home avec l'ancre
                    // Le code ci-dessous gérera le scroll une fois sur la page d'accueil
                }
            }
        });

        // Gérer le scroll initial si URL contient une ancre
        if (window.location.hash) {
            setTimeout(function() {
                const element = document.getElementById(window.location.hash.substring(1));
                if (element) {
                    element.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            }, 100);
        }
    });
</script>
